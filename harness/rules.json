    "components": [
      "ActionButton",
      "TextInput",
      "TopNavigation",
      "ListItem",
      "Chip",
      "Badge",
      "Tab",
      "BottomSheet",
      "AlertDialog",
      "Snackbar"
    ],
    "frame_naming": {
      "pattern": "^us(?P<us>[1-6])-screen-(?P<nn>\\d{2})(?P<warning>-warning)?$",
      "maps_to": "runs/us{us}/s2-spec/screen-{nn}.md",
      "warning_suffix": "-warning"
    }
  },
  "gates": {
    "G1": {
      "at": "S1->S2",
      "checks": [
        {
          "id": "G1-01",
          "rule": "count(refs.json) in [5,10]"
        },
        {
          "id": "G1-02",
          "rule": "all refs[].url hostname labels contain 'uibowl'"
        },
        {
          "id": "G1-03",
          "rule": "each refs[].id has refs/{id}.png"
        },
        {
          "id": "G1-04",
          "rule": "count(insights.md items) in [3,5]"
        },
        {
          "id": "G1-05",
          "rule": "each insight cites >=1 existing ref id"
        }
      ],
      "on_fail": {
        "goto": "S1",
        "max_retry": 2,
        "then": "stop_and_notify"
      }
    },
    "G2": {
      "at": "S2->S3",
      "checks": [
        {
          "id": "G2-01",
          "rule": "count(screen-*.md) in [2,3]"
        },
        {
          "id": "G2-02",
          "rule": "each spec has headers [목적, 유저스토리, 섹션, 컴포넌트, 상태]"
        },
        {
          "id": "G2-03",
          "rule": "spec 유저스토리 == input us"
        },
        {
          "id": "G2-04",
          "rule": "spec 컴포넌트 ⊆ allowed.components"
        },
        {
          "id": "G2-05",
          "rule": "spec 상태 ⊇ [기본, 빈 화면, 오류]"
        },
        {
          "id": "SVC-01",
          "source": "story-service 어기면 안 되는 것 #1",
          "rule": "if spec contains ('지도'|'경로') then 상태 contains '위치 동의 전'"
        },
        {
          "id": "SVC-02",
          "source": "story-service 어기면 안 되는 것 #1",
          "rule": "if spec contains '공유' then 섹션 contains '출발·도착 구간 가림'"
        },
        {
          "id": "SVC-04a",
          "source": "story-service 어기면 안 되는 것 #2",
          "rule": "if us == 2 then some spec text contains '2m'"
        }
      ],
      "on_fail": {
        "goto": "S2",
        "max_retry": 2,
        "then": "stop_and_notify"
      }
    },
    "G3": {
      "at": "S3->S4",
      "checks": [
        {
          "id": "G3-01",
          "rule": "count(01_Keyscreen frames) in [2,3]"
        },
        {
          "id": "G3-02",
          "rule": "all frames width==390 and height==844"
        },
        {
          "id": "G3-03",
          "rule": "approval.json.status == 'approved' and approval.json.us == input us"
        },
        {
          "id": "G3-04",
          "rule": "all frame names match allowed.frame_naming.pattern"
        }
      ],
      "human_approval": {
        "writer": "human_only",
        "commands": [
          "/approve us{N}",
          "/reject us{N} design|reference \"사유\""
        ],
        "agent_write": "blocked_by_hook"
      },
      "on_fail": {
        "rejected": {
          "design": "S2",
          "reference": "S1"
        }
      }
    },
    "G4": {
      "at": "S4->done",
      "checks": [
        {
          "id": "G4-01",
          "rule": "fills[].hex ∈ allowed.colors ∪ colors_extra"
        },
        {
          "id": "G4-02",
          "rule": "radius ∈ allowed.radius"
        },
        {
          "id": "G4-03",
          "rule": "fontSize ∈ allowed.fontSize"
        },
        {
          "id": "G4-04",
          "rule": "fontWeight ∈ allowed.fontWeight"
        },
        {
          "id": "G4-05",
          "rule": "padding[] and gap ∈ allowed.spacing"
        },
        {
          "id": "G4-06",
          "rule": "04_Screens frames width==390 and height==844"
        },
        {
          "id": "G4-08",
          "rule": "all frame names match allowed.frame_naming.pattern and map to an existing spec"
        },
        {
          "id": "G4-07",
          "rule": "per frame count(button with fill #10ab7d) <= 1"
        },
        {
          "id": "SVC-03",
          "source": "story-service 어기면 안 되는 것 #1",
          "rule": "frames mapped to specs containing '공유' have >=1 node named 'RouteMask'"
        },
        {
          "id": "SVC-04b",
          "source": "story-service 어기면 안 되는 것 #2",
          "rule": "if us == 2 then frames with name suffix -warning has TEXT node containing '2m'"
        },
        {
          "id": "SVC-05",
          "source": "story-service 어기면 안 되는 것 #2",
          "rule": "frames with name suffix -warning emphasis fills ∈ critical_hex",
          "critical_hex": [
            "#322323",
            "#4f2624",
            "#742826",
            "#921708",
            "#ca1d13",
            "#f73526",
            "#f8c5c3",
            "#fa342c",
            "#fde7e7",
            "#fdf0f0",
            "#fed4d2",
            "#ff6e60"
          ]
        }
      ],
      "on_fail": {
        "goto": "S4",
        "max_retry_per_rule": 3,
        "then": "stop_and_notify"
      }
    }
  }
}